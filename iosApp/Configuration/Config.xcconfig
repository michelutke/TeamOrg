// Apple Developer Team ID — set locally or injected by CI. Not a secret (it is embedded in every signed ipa), but kept out of git for tidiness.
TEAM_ID=

PRODUCT_NAME=teamorg
PRODUCT_BUNDLE_IDENTIFIER=ch.teamorg

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// API base URL, read at runtime via Info.plist. CI overrides this from the API_BASE_URL
// secret for TestFlight builds. $() breaks up "//" so xcconfig does not parse it as a comment.
API_BASE_URL=https:/$()/api.teamorg.app
