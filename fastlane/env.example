# Copy to fastlane/.env (gitignored, auto-loaded by fastlane) and fill in values for local deploys.
# CI does NOT read this file — GitHub environment secrets provide the same variables there.

# --- Android signing (values live in your password manager; keystore file: composeApp/release.jks) ---
ANDROID_KEYSTORE_PASSWORD = ""        # PKCS12 store password
ANDROID_KEY_ALIAS = ""                # key alias inside the keystore
ANDROID_KEY_PASSWORD = ""             # PKCS12: same value as the store password
ANDROID_VERSION_CODE = "1"            # CI uses the workflow run number
ANDROID_VERSION_NAME = "1.0.0"

# --- Google Play (Cloud Console service account, JSON key content — the whole file, one line ok) ---
PLAY_SERVICE_ACCOUNT_JSON = ""

# --- Updraft (app.getupdraft.com → app settings) ---
UPDRAFT_APP_KEY = ""
UPDRAFT_API_KEY = ""

# --- Apple / App Store Connect (Users and Access → Integrations; key role: App Manager) ---
APPLE_TEAM_ID = ""                    # developer.apple.com → Membership
ASC_KEY_ID = ""
ASC_ISSUER_ID = ""
ASC_KEY_P8_BASE64 = ""                # base64 -i AuthKey_XXXX.p8
IOS_DIST_CERT_P12_BASE64 = ""         # base64 -i Certificates.p12 (Apple Distribution)
IOS_DIST_CERT_PASSWORD = ""           # password chosen at .p12 export

# --- App runtime config ---
API_BASE_URL = ""
ONESIGNAL_APP_ID = ""
